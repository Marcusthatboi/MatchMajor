{
  "name": "matchmajor",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "cross-env PORT=3000 react-scripts start",
    "start:frontend": "cross-env PORT=3000 DANGEROUSLY_DISABLE_HOST_CHECK=true react-scripts start",
    "build": "react-scripts build",
    "build:prod": "cross-env REACT_APP_ENV=production react-scripts build",
    "serve": "serve -s build -l 3000",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "start:backend": "cd server && node server.js",
    "start:backend:dev": "cd server && npm run dev",
    "dev": "concurrently \"npm run start:frontend\" \"npm run start:backend:dev\"",
    "prod": "npm run build:prod && npm run serve"
  },
  "dependencies": {
    "all": "^0.0.0",
    "axios": "^1.5.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.3.1",
    "nodemon": "^3.1.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.17.0",
    "react-scripts": "^5.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "serve": "^14.2.0"
  },
  "proxy": "http://localhost:5000",
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
