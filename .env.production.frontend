# ============================================
# Production Environment - Vercel/Netlify (Frontend)
# ============================================
# Copy to .env.production in Vercel/Netlify dashboard as environment variables

REACT_APP_API_URL=https://your-api-domain.com/api
REACT_APP_ENV=production
REACT_APP_NAME=MatchMajor
REACT_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_ENABLE_ERROR_TRACKING=true
REACT_APP_ENABLE_PERFORMANCE_MONITORING=true

# External Services
REACT_APP_GA_ID=UA-XXXXXXXXX-X
REACT_APP_SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345

# Settings
REACT_APP_DEBUG=false
REACT_APP_REQUEST_TIMEOUT=10000
REACT_APP_CACHE_TTL=60000
