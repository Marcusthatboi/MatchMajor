# ============================================
# Production Environment - VPS/Docker Deployment
# ============================================
# Copy this to .env on production VPS
# IMPORTANT: Update all values before deployment

# === NODE ENVIRONMENT ===
NODE_ENV=production
PORT=5000
DEBUG=false

# === DATABASE - MongoDB Atlas or Self-Hosted ===
# For MongoDB Atlas (recommended for production):
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/matchmajor?retryWrites=true&w=majority
# For Docker self-hosted:
MONGODB_URI=mongodb://matchmajor_user:CHANGE_ME_PRODUCTION_PASSWORD@mongodb:27017/matchmajor?authSource=admin
MONGODB_TIMEOUT=30000
MONGODB_POOL_SIZE=20
MONGODB_MAX_POOL_SIZE=50

# === JWT & AUTHENTICATION ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_32_CHARS_MIN
JWT_EXPIRE=7d
SESSION_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET_32_CHARS_MIN
BCRYPT_ROUNDS=12

# === CORS & DOMAIN ===
FRONTEND_URL=https://yourdomain.com
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With

# === RATE LIMITING ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=900000
RATE_LIMIT_SEARCH_MAX=50
RATE_LIMIT_MESSAGE_MAX=30
RATE_LIMIT_UPLOAD_MAX=10
RATE_LIMIT_PASSWORD_RESET_MAX=3

# === SECURITY ===
ENABLE_HELMET=true
ENABLE_CORS=true
ENABLE_RATE_LIMIT=true
ENABLE_CSRF=true
HELMET_HSTS_PRELOAD=true
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
COOKIE_HTTP_ONLY=true

# === LOGGING & MONITORING ===
LOG_LEVEL=info
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_LOGGING=true

# === EXTERNAL SERVICES ===
# Email Service (SendGrid, Mailgun, etc.)
SENDGRID_API_KEY=

# Payment Processing (Stripe)
STRIPE_API_KEY=sk_live_your_stripe_key_here

# Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/12345

# Cloud Storage (AWS S3, etc.)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=matchmajor-prod
AWS_REGION=us-east-1

# === FILE UPLOAD ===
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# === APPLICATION ===
APP_NAME=MatchMajor
APP_VERSION=1.0.0
ENVIRONMENT=production
