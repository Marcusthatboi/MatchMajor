# Frontend Environment Variables
# Copy this file to .env for development or .env.production for production builds
# React environment variables must be prefixed with REACT_APP_

# ============================================
# API Configuration
# ============================================

# Backend API URL - change based on environment
REACT_APP_API_URL=http://localhost:5000/api

# Environment type
REACT_APP_ENV=development

# Application name
REACT_APP_NAME=MatchMajor

# Application version
REACT_APP_VERSION=1.0.0

# ============================================
# Feature Flags (Optional)
# ============================================

# Enable/disable features
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_ERROR_TRACKING=false
REACT_APP_ENABLE_PERFORMANCE_MONITORING=false

# ============================================
# External Services (Optional)
# ============================================

# Google Analytics
REACT_APP_GA_ID=

# Sentry Error Tracking
REACT_APP_SENTRY_DSN=

# Stripe (if using payment processing)
REACT_APP_STRIPE_PUBLIC_KEY=

# ============================================
# Development Settings
# ============================================

# Enable debug mode
REACT_APP_DEBUG=false

# Request timeout (milliseconds)
REACT_APP_REQUEST_TIMEOUT=10000

# Cache TTL (milliseconds)
REACT_APP_CACHE_TTL=60000
