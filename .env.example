# ============================================
# Environment Variables - Copy to .env
# ============================================

# === NODE ENVIRONMENT ===
NODE_ENV=development
PORT=5000

# === DATABASE ===
MONGODB_URI=mongodb://localhost:27017/matchmajor
MONGODB_TIMEOUT=30000
MONGODB_POOL_SIZE=10

# === JWT & AUTHENTICATION ===
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# === CORS & DOMAIN ===
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
ALLOWED_HEADERS=Content-Type,Authorization

# === RATE LIMITING ===
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5
RATE_LIMIT_AUTH_WINDOW=900000
RATE_LIMIT_SEARCH_MAX=50
RATE_LIMIT_UPLOAD_MAX=10

# === SECURITY ===
ENABLE_HELMET=true
ENABLE_CORS=true
ENABLE_RATE_LIMIT=true
ENABLE_CSRF=true
SESSION_SECRET=your_session_secret_key_min_32_chars
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
COOKIE_HTTP_ONLY=true

# === LOGGING ===
LOG_LEVEL=debug
ENABLE_REQUEST_LOGGING=true
ENABLE_ERROR_LOGGING=true

# === API KEYS & EXTERNAL SERVICES ===
# Add any external API keys here
STRIPE_API_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_secret

# === FILE UPLOAD ===
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# === EMAIL ===
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=noreply@matchmajor.com

# === SECURITY HEADERS ===
HELMET_CONTENT_SECURITY_POLICY=true
HELMET_HSTS_MAX_AGE=31536000
HELMET_HSTS_INCLUDE_SUBDOMAINS=true
HELMET_HSTS_PRELOAD=true

# === FEATURE FLAGS ===
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_SOCIAL_LOGIN=false
ENABLE_API_VERSIONING=true

# === ADMIN ===
ADMIN_EMAIL=admin@matchmajor.com
ADMIN_PASSWORD=change_me_in_production
